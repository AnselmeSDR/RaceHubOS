@echo off
setlocal enabledelayedexpansion
title RaceHubOS __VERSION__
cd /d "__TARGET_DIR__"

echo.
echo  ====================================
echo    RaceHubOS __VERSION__
echo  ====================================
echo.

echo  Checking ports...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :3001 ^| findstr LISTENING') do taskkill /F /PID %%a >nul 2>&1
echo  Ports cleared.
echo.
echo  App: http://localhost:3001
echo  Fermer cette fenetre pour arreter.
echo.

:: Le navigateur ne s'ouvre que si l'app repond vraiment
start /b powershell -NoProfile -Command "for ($i=0; $i -lt 30; $i++) { Start-Sleep 2; try { $r = Invoke-WebRequest -Uri http://localhost:3001/health -UseBasicParsing -TimeoutSec 2; if ($r.StatusCode -eq 200) { Start-Process http://localhost:3001; break } } catch {} }"

:loop
call npm start
set "EXITCODE=!errorlevel!"

:: 42 = mise a jour appliquee depuis l'app, on relance
if !EXITCODE! equ 42 (
    echo.
    echo  Redemarrage apres mise a jour...
    timeout /t 2 /nobreak >nul
    goto loop
)

:: 0 = arret normal : on ferme sans rien demander, comme avant
if !EXITCODE! equ 0 goto sortie

:: Tout le reste est un echec : ne pas laisser croire que l'app tourne
echo.
echo  ====================================
echo    RaceHubOS n'a pas demarre
echo  ====================================
echo.
if !EXITCODE! equ 43 (
    echo  La migration de la base de donnees a echoue.
    echo  La base n'a pas ete modifiee et une sauvegarde a ete creee
    echo  dans packages\backend\prisma\db-old\.
) else (
    echo  Erreur au demarrage ^(code !EXITCODE!^).
    echo  Causes possibles : mise a jour incomplete, dependances manquantes.
)
echo.
echo  Que voulez-vous faire ?
echo    [R] Relancer la mise a jour ^(reparation^)
echo    [D] Reessayer de demarrer
echo    [F] Fermer
echo.

choice /c RDF /n /m "Votre choix [R/D/F] : "
if errorlevel 3 goto fin
if errorlevel 2 goto loop

echo.
echo  Reparation en cours, ne fermez pas cette fenetre...
echo.
call npm run repair
if !errorlevel! neq 0 (
    echo.
    echo  La reparation a echoue. Relancez l'installeur RaceHubOS.
    echo.
    pause
    goto fin
)

:: La reparation dure plusieurs minutes : le guetteur initial a expire
start /b powershell -NoProfile -Command "for ($i=0; $i -lt 30; $i++) { Start-Sleep 2; try { $r = Invoke-WebRequest -Uri http://localhost:3001/health -UseBasicParsing -TimeoutSec 2; if ($r.StatusCode -eq 200) { Start-Process http://localhost:3001; break } } catch {} }"
goto loop

:fin
echo.
pause

:sortie
endlocal
