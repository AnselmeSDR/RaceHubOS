  {
   "id": "c1_t",
   "type": "text",
   "x": 80,
   "y": 550,
   "width": 306.90000000000003,
   "height": 202.5,
   "text": "Web (Vite plugin)\n\n• pages → /addons/<id>/…\n• sidebar entries\n• translations → namespace <id>\n• add-on Tailwind classes\n• imports: @/…  @addon/…  @base\n• a page crashes → error shown,\n  the rest of the app works",
   "originalText": "Web (Vite plugin)\n\n• pages → /addons/<id>/…\n• sidebar entries\n• translations → namespace <id>\n• add-on Tailwind classes\n• imports: @/…  @addon/…  @base\n• a page crashes → error shown,\n  the rest of the app works",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "c1",
   "strokeColor": "#1e1e1e",
   "lineHeight": 1.25
  },
  {
   "id": "c2",
   "type": "rectangle",
   "x": 590,
   "y": 540,
   "width": 490,
   "height": 270,
   "strokeColor": "#1e1e1e",
