  {
   "id": "tree",
   "type": "text",
   "x": 1155,
   "y": 180,
   "width": 374.4,
   "height": 180.0,
   "text": "addons/<id>/\n├─ racehubos-addon.json   manifest \n├─ package.json           dependencies\n├─ server/index.js        register(ctx)\n├─ web/index.jsx          pages, menu\n│  └─ locales/en|fr|de.json\n└─ overrides/packages/…   phase 2\n\naddons/.data/<id>/        data",
   "originalText": "addons/<id>/\n├─ racehubos-addon.json   manifest \n├─ package.json           dependencies\n├─ server/index.js        register(ctx)\n├─ web/index.jsx          pages, menu\n│  └─ locales/en|fr|de.json\n└─ overrides/packages/…   phase 2\n\naddons/.data/<id>/        data",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#1e1e1e",
   "lineHeight": 1.25
