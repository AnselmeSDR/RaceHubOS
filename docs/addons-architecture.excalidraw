  {
   "id": "c2_t",
   "type": "text",
   "x": 600,
   "y": 550,
   "width": 475.20000000000005,
   "height": 180.0,
   "text": "Server (Node)\n\n• register(ctx) at startup\n• ctx.router → /api/addons/<id>\n• ctx.events ← race:*, session:*, cu:*\n• ctx.prisma · ctx.extra · ctx.services · ctx.io\n• register() throws → add-on\n  disabled, the app starts",
   "originalText": "Server (Node)\n\n• register(ctx) at startup\n• ctx.router → /api/addons/<id>\n• ctx.events ← race:*, session:*, cu:*\n• ctx.prisma · ctx.extra · ctx.services · ctx.io\n• register() throws → add-on\n  disabled, the app starts",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "c2",
   "strokeColor": "#1e1e1e",
   "lineHeight": 1.25
