{
  "name": "racehubos",
  "version": "1.26.0",
  "description": "Open Source Race Management System for Carrera Digital 132/124",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @racehubos/backend",
    "dev:frontend": "npm run dev -w @racehubos/frontend",
    "build": "npm run build -w @racehubos/frontend",
    "start": "npm run start -w @racehubos/backend",
    "repair": "node scripts/repair.js",
    "lint": "eslint .",
    "check": "node scripts/check-rules.mjs",
    "check:push": "node scripts/check-rules.mjs --push",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs && echo \"Hooks installés : message vérifié à chaque commit, règles vérifiées avant chaque push.\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:build": "node site/scripts/build.mjs",
    "test:site": "node --test \"site/tests/*.test.mjs\" && playwright test -c site/playwright.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "baseline-browser-mapping": "^2.11.19",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "author": "",
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "tar": "^7.5.4",
    "lodash": "^4.17.22"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  }
}
